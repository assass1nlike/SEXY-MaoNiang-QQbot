# OneBot v11 / NoneBot settings are handled by your OneBot implementation.
# TARGET_USER_IDS is required unless you intentionally want every group member.
TARGET_USER_IDS=123456789
# Leave empty to listen in every group, or use comma-separated group IDs.
TARGET_GROUP_IDS=
# In these groups, every member may trigger the bot by explicitly @mentioning it.
ALL_USERS_GROUP_IDS=

# Responses-compatible upstream API. The bot posts to API_BASE_URL/responses.
API_BASE_URL=https://api.openai.com/v1
API_KEY=replace-with-your-key
API_MODEL=gpt-4o-mini
API_REASONING_EFFORT=low
SYSTEM_PROMPT=你是一个友善、简洁的 QQ 群助手。请直接回答用户的问题。
# Optional system prompt used only by `公共` conversations. Empty falls back to SYSTEM_PROMPT.
PUBLIC_SYSTEM_PROMPT=
# Optional fixed example turn for private conversations. Both values are required.
PREFILL_USER=
PREFILL_ASSISTANT=
# Optional fixed example turn for `公共` conversations. These are complete
# message contents, so write the example sender's [群昵称] yourself.
PUBLIC_PREFILL_USER=
PUBLIC_PREFILL_ASSISTANT=
API_TIMEOUT_SECONDS=60
MAX_MESSAGE_LENGTH=2000
MAX_CONVERSATION_TURNS=20
